generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Survey {
    id String @id @default(uuid())
    question String @unique
    answers Answer[] 
}

model Answer {
    id String @id @default(uuid())
    answer String @unique
    survey Survey @relation(fields: [surveyId], references: [id])
    surveyId String
}